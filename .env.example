# =============================================================================
# Kedra WRC Scraper - Environment Configuration
# Copy this file to .env and adjust values for your environment.
# =============================================================================

# --- MongoDB Configuration ---
MONGO_HOST=localhost
MONGO_PORT=27018
MONGO_DB=kedra_wrc

# --- MinIO (S3-compatible Object Storage) Configuration ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=kedra_admin
MINIO_SECRET_KEY=change_me_in_production
MINIO_SECURE=false
MINIO_LANDING_BUCKET=landing-docs
MINIO_TRANSFORMED_BUCKET=transformed-docs

# --- Scraping Configuration ---
WRC_BASE_URL=https://www.workplacerelations.ie
WRC_SEARCH_PATH=/en/search/
PARTITION_SIZE=monthly
CONCURRENT_REQUESTS=64
DOWNLOAD_DELAY=0.1
RETRY_TIMES=3
REQUEST_TIMEOUT=60
AUTOTHROTTLE_ENABLED=true
AUTOTHROTTLE_START_DELAY=1
AUTOTHROTTLE_MAX_DELAY=10
AUTOTHROTTLE_TARGET_CONCURRENCY=32.0

# --- Body IDs (WRC website filter values) ---
BODY_EMPLOYMENT_APPEALS_TRIBUNAL=2
BODY_EQUALITY_TRIBUNAL=1
BODY_LABOUR_COURT=3
BODY_WORKPLACE_RELATIONS_COMMISSION=15376 # its weird that its that hehe

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/scraper.log